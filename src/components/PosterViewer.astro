---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
}
const { src, alt, width, height } = Astro.props;
---

<poster-viewer>
  <figure class="poster">
    <button class="poster__thumbnail" type="button" aria-label="Ampliar cartel" aria-haspopup="dialog" data-open>
      <img src={src} alt={alt} width={width} height={height} decoding="async" />
    </button>
    <figcaption><button class="poster__expand mono" type="button" aria-haspopup="dialog" data-open>Ampliar cartel ⤢</button></figcaption>
  </figure>
  <dialog aria-label="Cartel del concierto ampliado">
    <button class="poster__close mono" type="button" data-close autofocus>Cerrar ×</button>
    <img class="poster__full" src={src} alt={alt} width={width} height={height} decoding="async" />
  </dialog>
</poster-viewer>

<script>
  class PosterViewer extends HTMLElement {
    connectedCallback() {
      const dialog = this.querySelector('dialog')!;
      const fullImage = this.querySelector<HTMLImageElement>('.poster__full')!;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let closing = false;
      let previousOverflow = '';
      const animate = (opening: boolean) => {
        const duration = reduceMotion.matches ? 0 : 180;
        dialog.animate(opening ? [{ opacity: 0 }, { opacity: 1 }] : [{ opacity: 1 }, { opacity: 0 }], { duration, easing: 'ease-out' });
        return fullImage.animate(
          opening ? [{ transform: 'scale(0.94)' }, { transform: 'scale(1)' }] : [{ transform: 'scale(1)' }, { transform: 'scale(0.94)' }],
          { duration, easing: 'ease-out' },
        ).finished;
      };
      const close = async () => {
        if (closing || !dialog.open) return;
        closing = true;
        await animate(false);
        dialog.close();
        closing = false;
      };
      this.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((button) => {
        button.addEventListener('click', () => {
          if (dialog.open) return;
          previousOverflow = document.documentElement.style.overflow;
          document.documentElement.style.overflow = 'hidden';
          dialog.showModal();
          void animate(true);
        });
      });
      this.querySelector('[data-close]')!.addEventListener('click', () => void close());
      dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        void close();
      });
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) void close();
      });
      dialog.addEventListener('close', () => {
        document.documentElement.style.overflow = previousOverflow;
      });
    }
  }
  customElements.define('poster-viewer', PosterViewer);
</script>

<style>
  :host, poster-viewer { display: block; width: 220px; max-width: 100%; }
  .poster { margin: 0; }
  button { font: inherit; color: inherit; cursor: pointer; }
  .poster__thumbnail { display: block; width: fit-content; margin-inline: auto; border: 2px solid var(--ink); padding: 0; background: transparent; cursor: zoom-in; }
  .poster__thumbnail img { width: auto; max-width: 100%; max-height: 356px; object-fit: contain; }
  figcaption { margin-top: 0.8rem; text-align: center; }
  .poster__expand { border: 0; background: transparent; padding: 0.35rem; font-size: 0.75rem; text-decoration: underline; text-underline-offset: 0.18em; }
  dialog { width: 100vw; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 4.5rem 1rem 1rem; border: 0; background: rgb(20 20 15 / 94%); color: var(--paper); }
  dialog[open] { display: grid; place-items: center; }
  dialog::backdrop { background: transparent; }
  .poster__full { width: auto; height: auto; max-width: 100%; max-height: calc(100dvh - 5.5rem); object-fit: contain; }
  .poster__close { position: absolute; top: 1rem; right: 1rem; min-height: 44px; padding: 0.6rem 1rem; border: 2px solid var(--yellow); background: var(--ink); color: var(--yellow); font-size: 0.85rem; }
  dialog :focus-visible { outline-color: var(--yellow); }
  @media (max-width: 820px) { poster-viewer { justify-self: center; } }
</style>
