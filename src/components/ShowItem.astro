---
import { formatDate } from '../data/shows.js';

const { show, tag = 'Pasado' } = Astro.props;
const ctaUrl = show.ticketUrl ?? show.infoUrl;
const ctaLabel = show.ticketUrl ? 'Entradas' : 'Anuncio';
---

<li class="show">
  <span class="show__date">{formatDate(show.date, show.datePrecision)}</span>
  <span class="show__venue">
    {show.venue} · {show.city}
    {show.ticketNote && <span class="show__notes">{show.ticketNote}</span>}
    {show.notes && <span class="show__notes">{show.notes}</span>}
  </span>
  {ctaUrl ? (
    <a
      class="show__tag show__tag--link"
      href={ctaUrl}
      target="_blank"
      rel="noopener noreferrer"
    >{ctaLabel} ↗</a>
  ) : (
    <span class="show__tag">{tag}</span>
  )}
</li>
