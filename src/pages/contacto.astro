---
import Base from '../layouts/Base.astro';
import { CONTACT, PRESS, LINKS, BAND } from '../config';
import { featuredRelease, releaseTypeLabel, formatDate } from '../data/releases';
---

<Base
  title="Contacto y prensa"
  description="Contacto de gracias x nada para booking, salas, promotores, prensa y colaboraciones. BIO corta y datos de la banda para medios."
  breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Contacto y prensa' }]}
>
  <section class="page-head wrap">
    <p class="kicker">Contacto</p>
    <h1>Habla con GxN</h1>
    <p class="lede" style="max-width: 52ch; margin-top: 1rem">
      ¿Montamos un bolo? Para conciertos, prensa y colaboraciones,
      escríbenos y hablamos.
    </p>
  </section>

  <section class="wrap" style="padding-bottom: clamp(2rem, 5vw, 3rem)">
    <div class="contact-blocks">
      <div class="contact-card">
        <h2>{CONTACT.booking}</h2>
        <p>Cuéntanos la sala, la ciudad y la fecha que tienes en mente.</p>
        <p class="mono"><a href={`mailto:${CONTACT.email}?subject=Concierto%20gracias%20x%20nada`}>{CONTACT.email}</a></p>
      </div>
      <div class="contact-card">
        <h2>{CONTACT.press}</h2>
        <p class="mono">
          Prensa: <a href={`mailto:${CONTACT.email}?subject=Prensa%20gracias%20x%20nada`}>{CONTACT.email}</a>
        </p>
        <p><a class="text-link mono" href={`mailto:${CONTACT.email}?subject=Material%20de%20prensa%20gracias%20x%20nada`}>Pedir material de prensa ↗</a></p>
      </div>
      <div class="contact-card">
        <h2>Redes</h2>
        <ul class="mono" style="list-style: none; padding: 0; margin: 0; display: grid; gap: 0.4rem">
          <li><a href={LINKS.spotify} target="_blank" rel="noopener noreferrer">Spotify ↗</a></li>
          <li><a href={LINKS.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a></li>
          <li><a href={LINKS.tiktok} target="_blank" rel="noopener noreferrer">TikTok ↗</a></li>
          <li><a href={LINKS.youtube} target="_blank" rel="noopener noreferrer">YouTube ↗</a></li>
        </ul>
      </div>
    </div>
  </section>

  <hr class="rule rule--thick" />

  <section class="wrap" style="padding-block: clamp(2rem, 5vw, 3.5rem)">
    <h2 class="kicker">Para medios · Bio corta</h2>
    <p class="lede" style="max-width: 62ch">{PRESS.bioShort}</p>

    <dl class="facts">
      <div><dt>Banda</dt><dd>{BAND.name}</dd></div>
      <div><dt>Origen</dt><dd>{BAND.origin}</dd></div>
      <div><dt>Estilo</dt><dd>Pop punk · Skate punk</dd></div>
      <div><dt>Formación</dt><dd>{BAND.formed}</dd></div>
      <div><dt>Último lanzamiento</dt><dd>{featuredRelease.title} ({releaseTypeLabel[featuredRelease.type]}, {formatDate(featuredRelease.date)})</dd></div>
      <div><dt>Spotify</dt><dd><a href={LINKS.spotify} target="_blank" rel="noopener noreferrer">perfil oficial ↗</a></dd></div>
    </dl>
  </section>
</Base>
